---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props { title: string; lede?: string; trail: Crumb[] }
const { title, lede, trail } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <Breadcrumbs trail={trail} />
    <h1>{title}</h1>
    {lede && <p class="lede" set:html={lede} />}
    <slot />
  </div>
</section>
