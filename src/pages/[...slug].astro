---
// Every migrated page that is a file, e.g. /cowlinge/history/interior.html
import { getCollection } from 'astro:content';
import MigratedPage from '../components/MigratedPage.astro';
import { isPolicy } from '../data/policies';
import { isIndexId } from '../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !isIndexId(p.id) && !isPolicy(p.id));
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<MigratedPage entry={entry} />
