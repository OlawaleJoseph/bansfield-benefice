---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { DSO, RECTOR, tel } from '../../data/site';

// Parish Safeguarding Officers come from the officials page, so there's one place to update them.
const officials = await getEntry('pages', 'benefice/officials');
const table = officials?.rendered?.html.match(/id="safeguarding"[\s\S]*?<\/table>/)?.[0] ?? '';
const officers = [...table.matchAll(/<tr>\s*<td>([^<]+)<\/td>\s*<td>([\s\S]*?)<\/td>\s*<\/tr>/g)].map((m) => ({
  parish: m[1].trim(),
  name: m[2].replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
}));
---
<BaseLayout title="Safeguarding" description="Safeguarding in the Bansfield Benefice: who to call if you're worried about a child or vulnerable adult.">
  <PageHero title="Safeguarding" trail={[{ label: 'Safeguarding' }]}
    lede="The Benefice is committed to the safeguarding of children, young people and adults. We follow the House of Bishops' guidance and policies, and each parish has a Parish Safeguarding Officer." />

  <section style="padding:48px 0">
    <div class="wrap">
      <div class="danger">
        <div style="flex:1 1 420px;min-width:0">
          <h2>Is someone in immediate danger?</h2>
          <p>Call the police on 999, then contact your local authority's Children or Adults Services.</p>
        </div>
        <a class="btn" href="tel:999">Call 999</a>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-bottom:48px">
    <div class="wrap">
      <h2>Worried about someone?</h2>
      <p class="section-intro">If you're concerned that a child or vulnerable adult has been harmed or may be at risk of harm, you can speak to either of these people in confidence.</p>
      <div class="grid g-300">
        <article class="card" style="gap:6px"><p style="color:var(--ink-4);font-size:16px">Rector</p><h3>{RECTOR.name}</h3><a href={tel(RECTOR.tel)} style="font-weight:700;font-size:22px;margin-top:6px">{RECTOR.tel}</a></article>
        <article class="card" style="gap:6px"><p style="color:var(--ink-4);font-size:16px">Diocesan Safeguarding Officer</p><h3>{DSO.name}</h3><a href={tel(DSO.tel)} style="font-weight:700;font-size:22px;margin-top:6px">{DSO.tel}</a></article>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-bottom:48px">
    <div class="wrap">
      <h2 style="margin-bottom:16px">Parish Safeguarding Officers</h2>
      <div class="table-box">
        <table style="min-width:0">
          <thead><tr><th scope="col">Parish</th><th scope="col">Officer</th></tr></thead>
          <tbody>{officers.map((o) => <tr><td style="font-weight:700">{o.parish}</td><td>{o.name}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="form-note" style="margin-top:12px">See all <a href="/benefice/officials.html">Benefice officials and safeguarding officers</a>.</p>
    </div>
  </section>

  <section class="section-tight" style="padding-bottom:72px">
    <div class="wrap grid g-300">
      <div class="panel">
        <h2>Our policy</h2>
        <p>The Church of England's House of Bishops requires every church to display safeguarding information. Each parish adopts the Church of England's safeguarding policy.</p>
        <p><a href="https://www.cofesuffolk.org/promoting-a-safer-church" style="font-weight:700">Promoting a safer church</a></p>
      </div>
      <div class="panel">
        <h2>Diocesan support</h2>
        <p>The Diocese of St Edmundsbury and Ipswich's safeguarding pages have vital links and information, including contacts for the Diocesan Safeguarding Adviser, who advises our Parish Safeguarding Officers.</p>
        <p><a href="https://www.cofesuffolk.org/for-parishes/promoting-a-safer-church/safeguarding-resources/" style="font-weight:700">Diocesan safeguarding resources</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
